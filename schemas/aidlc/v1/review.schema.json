{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nightshift:aidlc:v1:review",
  "title": "AIDLC v1 evidence-backed review record",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "reviewed_subject",
    "reviewer_context",
    "parse_status",
    "decision",
    "evidence_complete",
    "proof_ceiling",
    "lenses",
    "claims",
    "findings",
    "residual_risks",
    "outcome",
    "note"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {
      "type": "string",
      "enum": ["redteam", "self-review", "change-review"]
    },
    "reviewed_subject": {
      "type": "object",
      "required": ["kind", "refs"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["blueprint-plan", "revision-diff", "reviewed-change"]
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "base_revision": {"type": "string", "minLength": 1},
        "head_revision": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "reviewer_context": {
      "type": "string",
      "enum": ["fresh", "same-session", "unknown"]
    },
    "parse_status": {
      "type": "string",
      "enum": ["complete", "partial", "invalid"]
    },
    "decision": {
      "type": "string",
      "enum": ["PASS", "REQUEST_CHANGES", "CONDITIONAL"]
    },
    "evidence_complete": {"type": "boolean"},
    "proof_ceiling": {"$ref": "#/$defs/proof_state"},
    "lenses": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "allOf": [
        {"contains": {"properties": {"id": {"const": "requirements-correctness"}}}},
        {"contains": {"properties": {"id": {"const": "architecture-security"}}}},
        {"contains": {"properties": {"id": {"const": "tests-oracles"}}}},
        {"contains": {"properties": {"id": {"const": "delivery-operations"}}}},
        {"contains": {"properties": {"id": {"const": "adversarial-lifecycle"}}}}
      ],
      "items": {
        "type": "object",
        "required": ["id", "status", "note", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "requirements-correctness",
              "architecture-security",
              "tests-oracles",
              "delivery-operations",
              "adversarial-lifecycle"
            ]
          },
          "status": {
            "type": "string",
            "enum": ["complete", "partial", "failed", "not-applicable"]
          },
          "note": {"type": "string", "minLength": 1},
          "evidence": {"$ref": "#/$defs/evidence"}
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "tier", "statement", "boundary", "required_proof", "state", "evidence"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "tier": {"type": "string", "enum": ["core", "supporting"]},
          "statement": {"type": "string", "minLength": 1},
          "boundary": {"type": "string", "minLength": 1},
          "required_proof": {
            "type": "string",
            "enum": ["static", "executed", "behavior-sensitive"]
          },
          "state": {"$ref": "#/$defs/proof_state"},
          "evidence": {"$ref": "#/$defs/evidence"}
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "severity", "lens", "locus", "text", "evidence", "disposition",
          "remediation"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
          "severity": {
            "type": "string",
            "enum": ["blocking", "high", "medium", "low"]
          },
          "lens": {
            "type": "string",
            "enum": [
              "requirements-correctness",
              "architecture-security",
              "tests-oracles",
              "delivery-operations",
              "adversarial-lifecycle"
            ]
          },
          "locus": {"type": "string", "minLength": 1},
          "text": {"type": "string", "minLength": 1},
          "evidence": {"$ref": "#/$defs/evidence"},
          "disposition": {
            "type": "string",
            "enum": ["open", "fixed", "accepted-risk", "rewind"]
          },
          "remediation": {"type": ["string", "null"]},
          "verified_on": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "build_summary": {"type": "string", "minLength": 1},
    "outcome": {
      "type": "string",
      "enum": ["advance", "rewind", "needs_human"]
    },
    "rewind_to": {
      "type": "string",
      "enum": ["implement", "investigate", "blueprint", "plan", "redteam", "build"]
    },
    "note": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "PASS"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "parse_status": {"const": "complete"},
          "evidence_complete": {"const": true},
          "outcome": {"const": "advance"},
          "claims": {"contains": {"properties": {"tier": {"const": "core"}}}}
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "redteam"}}, "required": ["stage"]},
      "then": {
        "properties": {
          "reviewed_subject": {"properties": {"kind": {"const": "blueprint-plan"}}}
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "self-review"}}, "required": ["stage"]},
      "then": {
        "properties": {
          "reviewed_subject": {"properties": {"kind": {"const": "revision-diff"}}}
        }
      }
    },
    {
      "if": {"properties": {"stage": {"const": "change-review"}}, "required": ["stage"]},
      "then": {
        "properties": {
          "reviewed_subject": {"properties": {"kind": {"const": "reviewed-change"}}}
        }
      }
    },
    {
      "if": {
        "properties": {"decision": {"const": "REQUEST_CHANGES"}},
        "required": ["decision"]
      },
      "then": {
        "properties": {"outcome": {"const": "rewind"}},
        "required": ["rewind_to"]
      }
    },
    {
      "if": {
        "properties": {"decision": {"const": "CONDITIONAL"}},
        "required": ["decision"]
      },
      "then": {
        "properties": {"outcome": {"const": "needs_human"}}
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "rewind"}}, "required": ["outcome"]},
      "then": {"required": ["rewind_to"]},
      "else": {"not": {"required": ["rewind_to"]}}
    }
  ],
  "$defs": {
    "proof_state": {
      "type": "string",
      "enum": ["REFUTED", "UNPROVEN", "STATIC_ONLY", "PARTIAL", "PROVEN"]
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "additionalProperties": false
}
