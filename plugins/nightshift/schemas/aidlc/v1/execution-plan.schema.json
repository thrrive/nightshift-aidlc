{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nightshift:aidlc:v1:execution-plan",
  "title": "AIDLC hierarchical execution plan",
  "description": "Optional host-neutral subtask and model planning metadata.",
  "type": "object",
  "required": ["version", "mode", "subtasks", "model_plan"],
  "properties": {
    "version": {"const": 1},
    "mode": {"enum": ["gated", "yolo"]},
    "subtasks": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "required": ["id", "title", "goal", "done_when", "depends_on"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"},
          "title": {"type": "string", "minLength": 1},
          "goal": {"type": "string", "minLength": 1},
          "done_when": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "depends_on": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": true
      }
    },
    "model_plan": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "required": ["subtask_id", "step", "rationale", "estimate", "pricing_ref"],
        "properties": {
          "subtask_id": {"type": "string", "minLength": 1},
          "step": {"type": "string", "minLength": 1},
          "model_hint": {"type": ["string", "null"]},
          "rationale": {"type": "string", "minLength": 1},
          "estimate": {
            "type": "object", "required": ["input_tokens", "output_tokens"],
            "properties": {
              "input_tokens": {"type": "integer", "minimum": 0},
              "output_tokens": {"type": "integer", "minimum": 0},
              "cost_usd": {"type": "number", "minimum": 0}
            },
            "additionalProperties": true
          },
          "pricing_ref": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
