{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nightshift:aidlc:v1:workstreams",
  "title": "AIDLC v1 workstreams",
  "description": "An optional, bounded decomposition of independently owned build work.",
  "type": "object",
  "required": ["version", "merge_strategy", "items"],
  "properties": {
    "version": {
      "const": 1
    },
    "merge_strategy": {
      "const": "ordered"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "goal", "paths"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "goal": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.git(?:/|$))(?!.*[?*\\[])(?!\\s*$).+$"
            }
          },
          "model_hint": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "default": null
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
